# Volitelné: URL webhooku, kam se přeposílají odeslané kontaktní formuláře
# (Make, Zapier, n8n, Slack incoming webhook, vlastní e-mailový endpoint…).
# Bez nastavení se odeslání jen zaloguje na serveru.
CONTACT_WEBHOOK_URL=

# Měření – stejné jako na původním webu (Google Tag Manager s GA4).
# Souhlas s cookies řeší vlastní lišta s Google Consent Mode v2.
NEXT_PUBLIC_GTM_ID=GTM-KNHLSBW
