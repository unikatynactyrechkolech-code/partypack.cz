# Zkopírujte do .env.local (lokálně) a nastavte ve Vercelu: Project → Settings → Environment Variables.

# Supabase (sdílený projekt s webem Majdy Martinské): Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Volitelné – bez něj se poptávky zapisují přes funkci partypack_submit_inquiry
SUPABASE_SERVICE_ROLE_KEY=
# Tabulky Partypacku jsou v public s předponou partypack_
SUPABASE_SCHEMA=public

# Cloudflare R2 – nahrávání fotek z administrace
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=partypack

# E-mail s poptávkami přes Resend. Odesílací adresa musí být na doméně ověřené v Resend.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=info@partypack.cz
# Dočasně ověřená doména z Resend účtu, po ověření partypack.cz: Partypack web <poptavky@partypack.cz>
INQUIRY_FROM_EMAIL=Partypack web <formular@majdamartinska.com>

# Volitelné: další webhook pro poptávky (Make, Zapier, Slack…)
CONTACT_WEBHOOK_URL=

# Měření (Google Tag Manager s GA4), stejné jako na původním webu
NEXT_PUBLIC_GTM_ID=GTM-KNHLSBW

# Volitelné: veřejná adresa webu (kanonické URL, sitemap)
NEXT_PUBLIC_SITE_URL=https://partypack.cz
